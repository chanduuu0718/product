PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USER=admin
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
# Optional. In production point this at persistent storage, e.g. /var/data
APP_DATA_DIR=./data
